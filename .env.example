# Stripe (existing)
STRIPE_SECRET_KEY=sk_live_...

# Stripe webhook for /api/stripe-webhook (checkout.session.completed)
STRIPE_WEBHOOK_SECRET=whsec_...

# Download links: HMAC signing secret (any long random string) + where the
# pack PDFs live on the server (gitignored — upload them there manually,
# named <product-slug>.pdf, e.g. fulfillment/pdfs/galaxy-maths-lunar-ascent.pdf)
DOWNLOAD_SECRET=change-me-to-a-long-random-string
# PDF_DIR=fulfillment/pdfs        # default; override if you store them elsewhere
# MAX_DOWNLOADS=5                 # per-link usage cap (default 5)

# SendGrid — fulfillment emails (thank-you note + order download links)
SENDGRID_API_KEY=SG....

# Sender identity for fulfillment emails (must be verified in SendGrid —
# single-sender or domain authentication for edventureprintables.com)
FULFILLMENT_FROM=orders@edventureprintables.shop
FULFILLMENT_FROM_NAME=Edventure Printables
